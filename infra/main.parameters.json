{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=eastus2}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "allowedIpCidr": {
      "value": "${DEMO_ALLOWED_IP_CIDR}"
    },
    "additionalAllowedIpCidr": {
      "value": "${DEMO_ADDITIONAL_ALLOWED_IP_CIDR=}"
    },
    "webExists": {
      "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}"
    },
    "webImageName": {
      "value": "${SERVICE_WEB_IMAGE_NAME=mcr.microsoft.com/azuredocs/containerapps-helloworld:latest}"
    },
    "modelName": {
      "value": "${AZURE_AI_MODEL_NAME=gpt-5.4-mini}"
    },
    "modelVersion": {
      "value": "${AZURE_AI_MODEL_VERSION=2026-03-17}"
    },
    "modelSkuName": {
      "value": "${AZURE_AI_MODEL_SKU=GlobalStandard}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=10}"
    }
  }
}
